# Konfigurasi TUNGGAL Smart Posyandu (klien + server).
# Salin: cp .env.contoh .env
#
# Dibaca oleh:
#   server -> server/src/env.js
#   klien  -> Vite saat BANGUN (hanya VITE_*; nilainya ikut ke bundel)
#
# Sebelum dipasang: ganti KUNCI_RAHASIA, simpan KUNCI_CADANGAN terpisah dari
# berkas cadangannya, dan jangan pernah masukkan .env ke repositori.

# --- Klien ---------------------------------------------------------------
# Alamat API. Kosong = satu asal (disarankan): klien memanggil /masuk, /balita,
# dst. di host yang sama lewat Nginx. Diisi hanya bila klien dan API sengaja
# dipisah, mis. https://api.posyandu.desa.example.
#
# Nilai ini ditanam saat `npm run bangun`, bukan dibaca saat aplikasi dibuka.
# Bila terisi http://127.0.0.1:3000 lalu dipasang di VPS, tablet akan memanggil
# dirinya sendiri dan gagal tersambung. Untuk pengembangan lokal boleh diisi.
VITE_API=

# --- Server --------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/posyandu

# WAJIB diganti. Buat yang baru dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
KUNCI_RAHASIA=ganti-ini-di-produksi

# Enkripsi NIK dan berkas cadangan. Kosong = ikut KUNCI_RAHASIA.
KUNCI_ENKRIPSI=
KUNCI_CADANGAN=

PORT=3000
# Alamat dengar. 127.0.0.1 = hanya lewat Nginx di mesin yang sama (paling
# aman). Isi 0.0.0.0 hanya bila API sengaja dipisah dari Nginx.
HOST=127.0.0.1
TOLERANSI_JAM_KE_DEPAN=24

# Cookie sesi wajib `Secure` (hanya lewat HTTPS)?
#   (kosong) = ikut NODE_ENV; produksi -> Secure (paling aman)
#   false    = tanpa Secure. WAJIB bila diakses lewat http://<ip-vps>, kalau
#              tidak browser membuang cookie dan login selalu gagal meski kata
#              sandi benar. Sandi melintas tanpa enkripsi: jaringan internal saja.
#   true     = selalu Secure (wajib untuk akses publik lewat HTTPS).
COOKIE_SECURE=

# Proksi yang boleh menentukan IP klien lewat X-Forwarded-For.
#   loopback (bawaan) = hanya Nginx di mesin ini
#   false             = abaikan header itu
#   true              = percaya dari mana pun. JANGAN: bila server bisa
#                       dihubungi langsung, batas brute-force bisa dilewati
#                       dengan memalsukan header.
TRUST_PROXY=loopback
MENIT_SESI_TABLET=10080
MENIT_SESI_ADMIN=480
FOLDER_CADANGAN=cadangan
CADANGAN_HARIAN=true

# Tarik artikel tips KodeNara tiap hari 03.00 WIB ke kanal publik.
# Setel false bila VPS tidak boleh menghubungi internet sama sekali.
KODENARA_HARIAN=true

# Batas waktu satu pernyataan SQL (ms). Tanpa batas, satu kueri lambat menahan
# koneksi sampai selesai dan seluruh API bisa berhenti melayani. Naikkan bila
# pemulihan cadangan pada data sangat besar terpotong.
BATAS_WAKTU_KUERI_MS=10000

# Asal klien yang diizinkan CORS (pisahkan koma). Wajib bila klien dan API
# tidak satu asal, karena bukti masuk berupa cookie.
# ASAL_DIIZINKAN=http://127.0.0.1:5173,http://localhost:5173
