{
  "name": "smart-posyandu-server",
  "version": "1.0.0",
  "description": "API Smart Posyandu (Express + PostgreSQL), pengganti backend Python",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "cross-env NODE_ENV=test node --test tests/*.test.js",
    "demo": "node src/db/demo.js",
    "demo:hapus": "node src/db/demo.js --hapus",
    "siap": "npm run migrate",
    "cadangan": "node src/bin/cadangan.js",
    "pulih": "node src/bin/pulih.js",
    "buat-admin": "node src/bin/buat-admin.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
